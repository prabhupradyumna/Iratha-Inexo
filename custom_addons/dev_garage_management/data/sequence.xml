<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mt_customer_service_rating" model="mail.message.subtype">
            <field name="name">Customer Service Rating</field>
            <field name="res_model">dev.repair.request</field>
            <field name="default" eval="True"/>
            <field name="description">Ratings</field>
    </record>

    <record id="sequence_machine_repair_request" model="ir.sequence">
        <field name="name">sequence.machine.repair.request</field>
        <field name="code">dev.repair.request</field>
        <field name="prefix">CARD/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cron_notify_renew_service_garage" model="ir.cron">
        <field name="name">Service Renew Notification</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="model_id" ref="dev_garage_management.model_dev_repair_request"/>
        <field name="state">code</field>
        <field name="code">model.service_renew_cron()</field>
    </record>

    <record id="seq_calendar_event_appointment" model="ir.sequence">
		<field name="name">Appointment Sequence</field>
		<field name="code">calendar.event</field>
		<field name="prefix">APT</field>
		<field name="padding">4</field>
		<field name="company_id" eval="False"/>
	</record>
</odoo>
