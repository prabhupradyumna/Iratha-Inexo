<odoo>

    <record id="customer_email_template_garage_job_closed" model="mail.template">
        <field name="name">Job Card Done</field>
        <field name="email_from">{{object.user_id.partner_id and object.user_id.partner_id.email or ''}}</field>
        <field name="email_to">{{object.customer_id and object.customer_id.email or '' }}</field>
        <field name="subject">Ref {{object.name or '' }}</field>
        <field name="model_id" ref="dev_garage_management.model_dev_repair_request"/>
        <field name="report_template_ids" eval="[(4, ref('dev_garage_management.menu_machine_repair_request'))]"/>
        <field name="body_html"><![CDATA[

            	<p style="margin: 0px; padding: 0px; font-size: 13px;">
                     Dear <b><span t-esc="object.customer_id.name or ''"/></b>,
                    <br/><br/>
                   <p> Your repair request of job card number<b> <span t-esc="object.name or ''"/> </b> is done, </p>
                   <p>  so we have closed your request now. </p>
                   <p> We also attached the report of your job card.</p>
                   <br/>
                   <p>  Thanks For Your Participation...! </p>
                    <br/>
                   <p> You can reply to this email if you have any questions.</p>
                   <p>  Thank you... </p>
                    <br/>
                </p>


                ]]></field>
    </record>

    <record id="appointment_confirmation_email_template_id" model="mail.template">
        <field name="name">Appointment Confirmation</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="subject">Appointment Confirmed</field>
        <field name="email_from">{{ (object.partner_id.email_formatted if object.partner_id else user.email_formatted) }}</field>
        <field name="email_to">{{object.partner_id.email or ''}}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hello <t t-out="object.partner_id.name or ''"/><br/><br/>
                    Your appointment has been <strong>confirmed</strong>
                </p>
            </div>
        </field>
    </record>

    <record id="customer_service_renew_garage_template" model="mail.template">
        <field name="name">Service Renew Notification</field>
        <field name="email_from">{{object.user_id.partner_id and object.user_id.partner_id.email or ''}}</field>
        <field name="email_to">{{object.customer_id and object.customer_id.email or '' }}</field>
        <field name="subject">Service Renew Notification</field>
        <field name="model_id" ref="dev_garage_management.model_dev_repair_request"/>
        <field name="body_html"><![CDATA[

            	<p style="margin: 0px; padding: 0px; font-size: 13px;">
                     Dear <span t-esc="object.customer_id.name or ''"/>,
                    <br/><br/>
                   <p> Your repair request of job card number<b> <span t-esc="object.name or ''"/> </b> is done on <span t-esc="object.request_date or ''"/> </p>
                   <p>  now it's been <span t-esc="object.company_id.month_duration or ''"/> months from your last service date</p>
                   <br/>
                   <p>  So, We request you to service your vehicle </p>
                    <br/>
                   <p> If you have any questions regarding the renewal process or need help, please don't hesitate to contact us.</p>
                   <p> Thank you... </p>
                    <br/>
                </p>


                ]]></field>
    </record>


    <record id="rating_service_request_email_template" model="mail.template">
        <field name="name">Vehicle Service: Rating Request</field>
        <field name="model_id" ref="dev_garage_management.model_dev_repair_request"/>
        <field name="subject">{{object.name}}: Rate Our Vehicle Repair Service and Help Us Serve You Better</field>
        <field name="email_from">{{object.company_id and object.company_id.email or ''}}</field>
        <field name="partner_to">{{object.customer_id.id or False}}</field>
        <field name="body_html" type="html">
            <div>
                <t t-set="access_token" t-value="object._rating_get_access_token()"/>
                <table border="0" cellpadding="0" cellspacing="0" width="590" style="width:100%; margin:0px auto;">
                    <tbody>
                        <tr>
                            <td valign="top" style="font-size: 13px;">
                                Hello <b><span t-out="object.customer_id.name or ''"/></b>,
                                <br/>
                                <br/>
                                Please take a moment to rate our services related to the Job Card "
                                <strong>
                                    <span t-out="object.name"/>
                                </strong>
                                "
                                <t t-if="object.user_id">
                                    created by
                                    <strong>
                                        <span t-out="object.user_id.name"/>
                                    </strong>
                                    .
                                    <br/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: center;">
                                <table border="0" cellpadding="0" cellspacing="0" width="590"
                                       summary="o_mail_notification" style="width:100%; margin: 32px 0px 32px 0px;">
                                    <tr>
                                        <td style="font-size: 13px;">
                                            <strong>Tell us how you feel about our service</strong>
                                            <br/>
                                            <span style="text-color: #888888">(click on one of these smileys)</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-size: 13px;">
                                            <table style="width:100%;text-align:center;">
                                                <tr>
                                                    <td>
                                                        <a t-attf-href="/rate/{{ access_token }}/5">
                                                            <img alt="Satisfied"
                                                                 src="/rating/static/src/img/rating_5.png"
                                                                 title="Satisfied"/>
                                                        </a>
                                                    </td>
                                                    <td>
                                                        <a t-attf-href="/rate/{{ access_token }}/3">
                                                            <img alt="Not satisfied"
                                                                 src="/rating/static/src/img/rating_3.png"
                                                                 title="Not satisfied"/>
                                                        </a>
                                                    </td>
                                                    <td>
                                                        <a t-attf-href="/rate/{{ access_token }}/1">
                                                            <img alt="Highly Dissatisfied"
                                                                 src="/rating/static/src/img/rating_1.png"
                                                                 title="Highly Dissatisfied"/>
                                                        </a>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td valign="top" style="font-size: 13px;">
                                We appreciate your feedback. It helps us to improve continuously.
                                <br/><span style="margin: 0px 0px 0px 0px; font-size: 12px; opacity: 0.5; color: #454748;">This customer survey has been sent because your Job Card has been moved to the stage <b><span t-out="object.state"/></b></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </field>
        <field name="lang">{{object.customer_id.lang}}</field>
        <field name="auto_delete" eval="True"/>
    </record>

</odoo>
