<odoo>
    <!--form-->
    <record id="form_product_sale_history_wizard" model="ir.ui.view">
        <field name="name">form.product.sale.history.wizard</field>
        <field name="model">product.sale.history</field>
        <field name="arch" type="xml">
            <form string="Product Sale  History Report">
                <group>
                    <group>
                        <field name="start_date"/>
                    </group>
                    <group>
                        <field name="end_date" />
                    </group>
                </group>
                <footer>
                    <button string="Print PDF" name="print_product_sale_history_report" type="object" class="oe_highlight"/>
                    &#160;or&#160;
                    <button string="Close Window" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!--action-->
    <record id="action_product_sale_history" model="ir.actions.act_window">
        <field name="name">Product Sale History</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.sale.history</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="form_product_sale_history_wizard"/>
        <field name="target">new</field>
    </record>
    
    <menuitem name="Product Sale History"
              id="menu_product_sale_history"
              parent="dev_garage_management.menu_dev_garage_reporting"
              action="action_product_sale_history"
              sequence="3"
              />
</odoo>
