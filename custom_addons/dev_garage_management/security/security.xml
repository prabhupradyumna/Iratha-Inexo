<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

<!--    <record model="ir.module.category" id="category_machine">-->
     <record model="res.groups.privilege" id="category_machine">
    
        <field name="name">Garage Management</field>
        <field name="description">Helps you handle your Machine Repair Request Access.</field>
        <field name="sequence">2</field>
    </record>
    
    <record id="group_machine_user" model="res.groups">
        <field name="name">User</field>
<!--        <field name="category_id" ref="dev_garage_management.category_machine"/>-->
        <field name="privilege_id" ref="dev_garage_management.category_machine"/>
        <field name="comment">user will have access own Machine Repair Details.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    
    <record id="group_machine_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">user will access all Machine Repair Details.</field>
<!--        <field name="category_id" ref="dev_garage_management.category_machine"/>-->
        <field name="privilege_id" ref="dev_garage_management.category_machine"/>
        <field name="implied_ids" eval="[(4, ref('dev_garage_management.group_machine_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    
    
    <record id="repair_request_multi_company" model="ir.rule">
        <field name="name">Machine Repair Request Multi Company</field>
        <field name="model_id" ref="model_dev_repair_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>


    <record id="group_own_repair_request" model="ir.rule">
        <field name="name">View Own Machine Repair Request</field>
        <field ref="model_dev_repair_request" name="model_id"/>
        <field name="domain_force">['|',('user_id','=',user.id),('team_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_machine_user'))]"/>
    </record>
    
    <record id="group_manager_see_all_machine_repair_request" model="ir.rule">
        <field name="name">View All Machine Repair Request</field>
        <field ref="model_dev_repair_request" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_machine_manager'))]"/>
    </record>
    

    </data>
</odoo>
