<odoo>
    
    <record model="ir.ui.view" id="view_repair_requst_kanban">
            <field name="name">dev.repair.request.kanban</field>
            <field name="model">dev.repair.request</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="name"/>
                    <field name="desc"/>
                    <field name="customer_id"/>
                    <field name="request_date"/>
                    <field name="state"/>
                    <field name="priority"/>
                    <templates>
<!--                        <t t-name="kanban-box">-->
                          <t t-name="card">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_record_top mb16">
                                    <div class="o_kanban_record_headings mt4">
                                        <strong class="o_kanban_record_title">
                                            <span class="fa fa-user me-2" aria-label="Partner" title="Partner"/>
                                             <span><t t-esc="record.customer_id.value"/></span></strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span><t t-esc="record.desc.value"/> </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left text-muted">
                                        <span style="color:black;"><t t-esc="record.name.value"/></span>
                                        <span><t t-esc="record.request_date.value"/></span>
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="state" widget="label_selection" options="{'classes': {'draft': 'info', 'confirm': 'info', 'assign': 'info' , 'cancel': 'danger', 'in_progress': 'success', 'done': 'success'}}"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        
    <!--field-->
    <record id="view_dev_repair_request_form" model="ir.ui.view">
        <field name="name">view.dev.repair.request.form</field>
        <field name="model">dev.repair.request</field>
        <field name="arch" type="xml">
            <form string="Repair Request">
                <header>
                    <button name="action_assign_request" type="object" string='Assign' class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_confirm_request" type='object' string='Confirm' class="oe_highlight" invisible="state != 'assign'"/>
                    <button name="action_process_request" type="object" string='Process' class="oe_highlight" invisible="state != 'confirm'"/>
                    <button name="action_create_diagnostic" type="object" string="Create Diagnosis" class="oe_highlight" invisible="diagnosys_id != False or state != 'in_progress'"/>
                    <button name="action_create_workorder" type="object" string="Create Workorder" class="oe_highlight" invisible="workorder_id != False or state != 'in_progress'"/>
                    <button name="action_done_request" type="object" string="Done" invisible="state != 'in_progress'" class="oe_highlight"/>
                    <button name="action_cance_request" type="object" string="Cancel" invisible="state not in ['in_progress','draft','assign','confirm']"/>
                    <button name="action_set_draft_request" type="object" string="Set To Draft" invisible="state != 'cancel'"/>
                    <button name="send_rating_email" string='Send Rating Email'
                        type="object" class="oe_highlight" icon="fa-star"
                        invisible="rating_text != False or state != 'done'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,assign,confirm,in_progress,done"/>
                </header>
                <sheet>
                     <div class="oe_button_box" name="button_box">
                         <!-- <button name="action_view_lead" type="object" class="oe_stat_button" icon="fa-link"
                                invisible="lead_counter == 0">
                            <field string="Lead" name="lead_counter" widget="statinfo"/>
                        </button> -->
                        <button name="action_view_sale_order" type="object" class="oe_stat_button" icon="fa-usd" 
                                invisible="sale_count == 0">
                            <field string="Sales" name="sale_count" widget="statinfo"/>
                        </button>
                        <button name="view_machine_diagnosys" type="object" class="oe_stat_button"
                                icon="fa-list" invisible="diagnosys_id == False">
                            <div class="o_stat_info">
                                <span class="o_stat_text"><b>Vehicle <br/>Diagnosis</b></span>
                            </div>
                        </button>
                        <button name="view_machine_workorder" type="object" class="oe_stat_button"
                                icon="fa-building-o" invisible="workorder_id == False">
                            <div class="o_stat_info">
                                <span class="o_stat_text"><b>Work Order</b></span>
                            </div>
                        </button>
                        <button name="action_get_attachment_view" class="oe_stat_button" icon="fa-file-text-o" type="object">
                            <field name="doc_count" widget="statinfo" string="Images" options="{'reload_on_button': true}"/>
                        </button>
                     </div>
                     <div class="oe_title">
                        <h2 class="o_row">
                            <field name="name" readonly="1"/>
                        </h2>
                     </div>
                    <div class="oe_title">
                        <label for="desc" string='Name' class="oe_edit_only"/>
                        <h1 class="o_row">
                            <field name="desc" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" required="1" readonly="state != 'draft'"/>
                            <field name="phone" required="1" readonly="state != 'draft'"/>
                            <field name="email" readonly="state != 'draft'"/>
                            <field name="diagnosys_id" invisible="1"/>
                            <field name="workorder_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="request_date" required="1" readonly="state != 'draft'"/>
                            <field name="close_date"  readonly="state not in ['draft','assign']"/>
                            <field name="duration" widget="float_time"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="project_id"  readonly="state not in ['draft','assign']"/>
                            <field name="company_id" required="1" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="team_id" required="1" readonly="state != 'draft'"/>
                            <field name="user_id" required="1" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string='Vehicle Information'>
                        <group>
                            <field name="product_id"
                                    options="{'no_create': True, 'no_create_edit':True}" 
                                    readonly="state != 'draft'"
                                    string='Vehicle Model'
                                     />
                            <field name="service_id" readonly="state != 'draft'"/>
                            <field name="service_type_id" readonly="state != 'draft'"/>
                            <field name="demage"  readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="machine_name" readonly="state != 'draft'" string='Vehicle Name'/>
                            <field name="vehicle_number" readonly="state != 'draft'"/>
                            <field name="vehicle_meter" required="1"/>
                            <field name="brand" readonly="state != 'draft'"/>
                            <field name="machine_year" readonly="state != 'draft'"/>
                            <field name="is_repair" readonly="state in ['done','cancel']"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="notes" string="Description">
                            <field name="notes" no_label="1" 
                                   readonly="state != 'draft'"/>
                        </page>
                        <page string='Timesheet' name="timesheet">
                            <field name="timesheet_lines" editable="bottom" 
                                   readonly="1">
                                <list editable="bottom">
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="date" required="1"/>
                                    <field name="employee_id" required="1"/>
                                    <field name="project_id" required="1"/>
                                    <field name="account_id"/>
                                    <field name="name"/>
                                    <field name="unit_amount" widget="float_time" string='Duration (Hours)' sum="unit_amount"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="company_id" invisible="1"/>
                                            <field name="date"/>
                                            <field name="user_id"/>
                                            <field name="project_id"/>
                                        </group>
                                        <group>
                                            <field name="account_id"/>
                                            <field name="name"/>
                                            <field name="unit_amount" widget="float_time"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page name="estimation" string='Consume Parts'>
                            <field name="product_lines" readonly="1" force_save="1">
                                <list editable="bottom">
                                    <field name="product_id" domain="[('is_machine_part','=',True)]"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price" sum="price"/>
                                    <field name="repair_request_id" column_invisible="1"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="name"/>
                                        </group>
                                        <group>
                                            <field name="quantity"/>
                                            <field name="uom_id"/>
                                            <field name="price"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page name="service_charge" string='Service Charge'>
                            <field name="service_product_lines" readonly="state == 'done' or sale_count != 0 " >
                                <list editable="bottom">
                                    <field name="product_id" domain="[('type','=','service'),('is_machine_part','=',True)]"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price" sum="price"/>
                                    <field name="repair_request_id" column_invisible="1"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="name"/>
                                        </group>
                                        <group>
                                            <field name="quantity"/>
                                            <field name="uom_id"/>
                                            <field name="price"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string='Images'>
                            <field name="document_ids" mode="kanban" context="{'default_res_id': id,'default_res_model': 'dev.repair.request','res_model':'dev.repair.request','res_name':name}" domain="[('res_id','=',id),('res_model','=','dev.repair.request')]" readonly="1">
                                <kanban>
                                    <field name="name"/>
                                    <field name="res_id"/>
                                    <field name="res_model"/>
                                    <field name="datas"/>
                                    <field name="id"/>
                                    <field name="mimetype"/>
                                    <templates>
<!--		                                <t t-name="kanban-box">-->
		                                  <t t-name="card">
		                                    <div class="oe_kanban_global_click" style="max-width: 200px">
		                                        <div class="o_kanban_record_top">
		                                        	<img t-att-src="kanban_image('ir.attachment', 'datas', record.id.raw_value)" height="100" width="182" class="oe_avatar oe_kanban_avatar_smallbox mb0" alt='img'/>

		                                            <a t-if="! read_only_mode" type="delete" class="text-danger">
		                                                <i class="fa-times" title="Delete"/>
		                                            </a>
		                                        </div>
		                                        <div class="oe_kanban_details" style="text-align:center">
									                <p><h5><field name="name"/></h5></p>
											    </div>
		                                    </div>
		                                </t>
		                            </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string='Inspection Checklist' name='inspection'>
                            <group >
                                <group>
                                    <field name="inspection_template_id" readonly="state in ['in_progress','done','cancel']" />
                                </group>
                                <group style="text-align:right">
                                    <button name="load_inspection" string='Load Inspection' invisible="state in ['in_progress','done','cancel']"
                                            type="object" class="oe_highlight" style="float:left" />
                                </group>
                            </group>
                            <field name="instruction_lines" readonly="state in ['in_progress','done','cancel']">
                                <list editable="bottom">
                                    <field name="instruction_id" />
                                    <field name='is_check' readonly="1" invisible="is_check == False"/>
                                    <button name="action_check" string='Checked' type="object" class="oe_highlight" invisible="is_check == True"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="instruction_id"/>
                                        </group>
                                        <group>
                                            <field name="is_check" readonly="1"/>
                                        </group>
                                    </group>
                                </form>
                            
                            </field>
                        </page>
                        <page string='Rating' name="rating"
                               invisible = "feedback_date == False">
                            <group>
                                <group>
                                    <field name="feedback_rate"  widget="priority"/>
                                    <field name="feedback_date"/>
                                </group>
                                <group>
                                    <div colspan="2" class="text-center" name="rating_image_container">
                                        <field name="rating_image" widget="image"/>
                                        <div class="mt4">
                                            <strong><field name="rating_text"/></strong>
                                        </div>
                                    </div>
                                </group>
                            </group>
                            <group string='Review'>
                                <field name="review" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!--tree-->
    <record id="view_dev_repair_request_tree" model="ir.ui.view">
        <field name="name">view.dev.repair.request.tree</field>
        <field name="model">dev.repair.request</field>
        <field name="arch" type="xml">
            <list string="Job Card">
                <field name="name" string='Number'/>
                <field name="desc" string='Name'/>
                <field name="customer_id"/>
                <field name="request_date"/>
                <field name="close_date"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="duration" widget="float_time" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="state" decoration-success="state == 'in_progress' or state == 'done'" decoration-info="state == 'draft' or state == 'assign' or state == 'confirm'" decoration-danger="state == 'cancel'" widget="badge" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_dev_repair_request_calendar" model="ir.ui.view">
        <field name="name">view.dev.repair.request.calendar</field>
        <field name="model">dev.repair.request</field>
        <field name="arch" type="xml">
            <calendar string="Job Card" date_start="request_date" color="state" hide_time="true" event_limit="5">
                <field name="customer_id" avatar_field="image_128"/>
                <field name="desc"/>
                <field name="state" filters="1" invisible="1"/>
            </calendar>
        </field>
    </record>
    
    <record model="ir.ui.view" id="view_dev_repair_request_graph">
        <field name="name">view.dev.repair.request.graph</field>
        <field name="model">dev.repair.request</field>
        <field name="arch" type="xml">
            <graph string="Repair Request" sample="1">
                <field name="customer_id"/>
            </graph>
        </field>
    </record>
    
    <record model="ir.ui.view" id="view_dev_repair_request_pivot">
        <field name="name">view.dev.repair.request.pivot</field>
        <field name="model">dev.repair.request</field>
        <field name="arch" type="xml">
            <pivot string="Repair Request" sample="1">
                <field name="request_date" type="row"/>
            </pivot>
        </field>
    </record>
    
    <record id="view_dev_repair_request_activity" model="ir.ui.view">
        <field name="name">view.dev.repair.request.activity</field>
        <field name="model">dev.repair.request</field>
        <field name="arch" type="xml">
            <activity string="Repair Request">
                <templates>
                    <div t-name="activity-box">
                        <div>
                            <field name="name" display="full"/>
                            <field name="customer_id" muted="1" display="full"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>
    
    <record id="view_dev_machine_repair_requst_filter" model="ir.ui.view">
            <field name="name">machine.repair.request.filter</field>
            <field name="model">dev.repair.request</field>
            <field name="priority" eval="15"/>
            <field name="arch" type="xml">
                <search string="Search Request">
                    <field name="name" string="Job Card" filter_domain="['|', '|', ('name', 'ilike', self), ('desc', 'ilike', self), ('customer_id', 'child_of', self)]"/>
                    <field name="vehicle_number" string='Vehicle Number'/>
                    <field name="customer_id" operator="child_of"/>
                    <field name="user_id"/>
                    <field name="team_id" string="Team"/>
                    <filter string="My Job Card" domain="[('user_id', '=', uid)]" name="my_request_filter"/>
                    <separator/>
                    <filter string='Repaired' name='is_required' domain="[('is_repair','=',True)]"/>
                    <filter string='Not Repaired' name='is_not_required' domain="[('is_repair','=',False)]"/>
                    <separator/>
                    <filter string="Draft" name="state_draft" domain="[('state', '=','draft')]"/>
                    <filter string="Assign" name="state_assign" domain="[('state', '=','assign')]"/>
                    <filter string="Confirm" name="state_confirm" domain="[('state', '=','confirm')]"/>
                    <filter string="In Process" name="state_process" domain="[('state', '=','in_progress')]"/>
                    <filter string="Done" name="state_done" domain="[('state', '=','done')]"/>
                        
<!--                    <group expand="0" string="Group By">-->
                        <filter string="Vehicle Model" name="machine" domain="[]" context="{'group_by': 'product_id'}"/>
                        <filter string="Technician" name="technician" domain="[]" context="{'group_by': 'user_id'}"/>
                        <filter string="Team" name="team" domain="[]" context="{'group_by': 'team_id'}"/>
                        <filter name="customer" string="Customer" domain="[]" context="{'group_by': 'customer_id'}"/>
                        <filter name="state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
                        <filter name="priority" string="Priority" domain="[]" context="{'group_by': 'priority'}"/>
                        <filter string="Request Date" name="order_month" domain="[]" context="{'group_by': 'request_date'}"/>
<!--                    </group>-->
               </search>
            </field>
        </record>

    <record id="action_machine_repair_request" model="ir.actions.act_window">
        <field name="name">Job Card</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dev.repair.request</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="view_dev_machine_repair_requst_filter"/>
        <field name="help" type="html">
             <p> Create New Job Card<br/>
                Odoo helps you track all activities related to your job cards.
             </p>
        </field>
    </record>

              
    <menuitem name="Job Card"
              id="menu_dev_machine_repair_request"
              parent="dev_garage_management.menu_dev_machine_repair"
              action="action_machine_repair_request"
              sequence="1"/>

</odoo>
