<odoo>

    <record id="view_product_template_part_form" model="ir.ui.view">
         <field name="name">view.product.template.part.form</field>
         <field name="model">product.template</field>
         <field name="inherit_id" ref="product.product_template_form_view"/>
         <field name="arch" type="xml">
            <xpath expr="//label[@for='sale_ok']" position="after">
                <br/>
                <field name="is_machine_part"/>
                <label for="is_machine_part"/>
            </xpath>
         </field>
    </record>

    <!--tree-->
    <record id="view_repair_machine_tree" model="ir.ui.view">
        <field name="name">view.repair.machine.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Vehicles">
                <field name="name"/>
                <field name="default_code"/>
                <field name="list_price"/>
                <field name="standard_price"/>
            </list>
        </field>
    </record>

    <record id="action_repaire_machine_parts" model="ir.actions.act_window">
        <field name="name">Vehicle Parts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.template</field>
        <field name="context">{'default_is_machine_part' : 1}</field>
        <field name="domain">[('is_machine_part', '=', 1)]</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem name="Vehicle Parts"
              id="menu_dev_machine_parts"
              parent="dev_garage_management.menu_dev_repair_machine"
              action="action_repaire_machine_parts"
              sequence="2"/>
</odoo>
