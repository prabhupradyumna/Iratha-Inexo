                                    </div>
                                    <div class="btn-group flex-grow-1 mb-1" style="margin-left:10px;">
                                        <a class="btn btn-secondary btn-block o_print_btn o_portal_invoice_print" t-att-href="repair.get_portal_url(report_type='pdf')" id="print_repair_report" title="Print" target="_blank"><i class="fa fa-print"/> Print</a>
                                    </div>
                                </div>
                            </li>
                            <li class="navspy list-group-item pl-0 flex-grow-1" t-ignore="true" role="complementary">
                                <ul class="nav flex-column bs-sidenav"></ul>
                            </li>
<!--                            <li t-if="repair.user_id" class="list-group-item flex-grow-1">-->
<!--                                <div class="small mb-1"><strong class="text-muted">Your Contact</strong></div>-->
<!--                                <div class="row flex-nowrap">-->
<!--                                    <div class="col flex-grow-0 pr-2">-->
<!--                                        <img class="rounded-circle mr4 float-left o_portal_contact_img" t-if="repair.user_id.image_1024" t-att-src="image_data_uri(repair.user_id.image_1024)" alt="Contact"/>-->
<!--                                        <img class="rounded-circle mr4 float-left o_portal_contact_img" t-if="not repair.user_id.image_1024" src="/web/static/src/img/placeholder.png" alt="Contact"/>-->
<!--                                    </div>-->
<!--                                    <div class="col pl-0" style="min-width: 150px">-->
<!--                                        <span t-field="repair.user_id" t-options='{"widget": "contact", "fields": ["name", "phone"], "no_marker": True}'/>-->
<!--                                        <a href="#discussion" class="small"><i class="fa fa-comment"></i> Send message</a>-->
<!--                                    </div>-->
<!--                                </div>-->
<!--                            </li>-->
                            <div t-if="repair.user_id">
                                <h6><small class="text-muted">Your contact</small></h6>
                                <div class="o_portal_contact_details d-flex flex-column gap-2">
                                    <div class="d-flex justify-content-start align-items-center gap-2">
                                        <img class="o_avatar o_portal_contact_img rounded" t-att-src="image_data_uri(repair.user_id.image_1024)" alt="Contact"/>
                                        <div>
                                            <span t-field="repair.user_id"
						t-options='{"widget": "contact", "fields": ["name", "phone"], "no_marker": True}'/>
                                            <a href="#discussion" class="d-flex align-items-center gap-2 small fw-bold">
                                            Send message
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </ul>
                    </t>
                </t>
                <div id="repair_content" class="col-12 col-lg justify-content-end">
	                <div t-attf-class="card #{'pb-5' if report_type == 'html' else ''}">
<!--                        <div t-call="dev_garage_management.repair_portal_content"/>-->
                         <t t-call="dev_garage_management.repair_portal_content"/>
                    </div>

	                <div id="repair_communication" class="mt-4">
	                    <h2>Communication</h2>
	                    <t t-call="portal.message_thread">
	                        <t t-set="object" t-value="repair"/>
	                    </t>
	                </div>
	            </div>
            </div>
        </xpath>
    </template>
    
    
    <template id="repair_portal_content" name="Repair Portal Content">
        <div id="introduction" t-attf-class="pb-2 pt-3 #{'card-header bg-white' if report_type == 'html' else ''}">
            <div class="row">
                <div class="col-12">
                    <h2 class="my-0 text-center">
                        <span t-esc="repair.desc"/> [<span t-esc="repair.get_selection_label('dev.repair.request','state',repair.state)"/>]
                    </h2>
                </div>
            </div>
        </div>
        
        <div t-attf-class="#{'card-body' if report_type == 'html' else ''}">
            <!-- Informations -->
            <div id="informations">
                <style>
                        table .my_table{
                            width:100%;
                            font-size:13px;
                        }
                        .my_table td{
                            padding:10px;
                        }
                        .my_time_table th{
                            padding:10px;
                            border-bottom:1px solid #f5f5f5;
                        }
                        .my_time_table td{
                            padding:10px;
                            border-bottom:1px solid #f5f5f5;
                        }
                    </style>
                    
                <!-- Clinet Details-->
                <div class="row">
                    <div class="col-12" style="border-bottom:1px solid #f5f5f5">
                        <h3>Client Information</h3>
                    </div>
                </div>
                <div class="row">
                    <table width="100%" class="my_table">
                        <tr>
                            <td style="width:10%"><b>Name</b></td>
                            <td colspan="3"><span t-field="repair.customer_id"/></td>
                        </tr>
                        <tr>
                            <td style="width:10%"><b>Phone</b></td>
                            <td style="width:40%"><span t-field="repair.phone"/></td>
                            <td style="width:10%"><b>Email</b></td>
                            <td style="width:40%"><span t-field="repair.email"/></td>
                        </tr>
                    </table>
                </div>
                
                <!-- Machine Details-->
                <div class="row">
                    <div class="col-12" style="border-bottom:1px solid #f5f5f5">
                        <br/><br/>
                        <h3>Vehicle Information</h3>
                    </div>
                </div>
                <div class="row">
                    <table width="100%" class="my_table">
                        <tr>
                            <td style="width:15%"><b>Vehicle Model</b></td>
                            <td style="width:35%">
                                <t t-if="not repair.product_id">
                                    <span t-field="repair.machine_name"/>
                                </t>
                                <t t-if="repair.product_id">
                                    <span t-field="repair.product_id.name"/>
                                </t>
                            </td>
                            <td style="width:15%"><b>Brand</b></td>
                            <td style="width:35%"><span t-field="repair.brand"/></td>
                        </tr>
                        <tr>
                            <td style="width:15%"><b>Vehicle No</b></td>
                            <td style="width:35%"><span t-field="repair.vehicle_number"/></td>
                            <td style="width:15%"><b>Meter Reading</b></td>
                            <td style="width:35%"><span t-field="repair.vehicle_meter"/></td>
                        </tr>
                        <tr>
                            <td style="width:15%"><b>Service</b></td>
                            <td style="width:35%"><span t-field="repair.service_id"/></td>
                            <td style="width:15%"><b>Man. Year</b></td>
                            <td style="width:35%"><span t-field="repair.machine_year"/></td>
                        </tr>
                        <tr>
                            <td style="width:15%"><b>Service Type</b></td>
                            <td style="width:35%"><span t-field="repair.service_type_id"/></td>
                            <td style="width:15%"></td>
                            <td style="width:35%"></td>
                        </tr>
                        <tr>
                            <td style="width:15%"><b>Damage</b></td>
                            <td colspan="3"><span t-field="repair.demage"/></td>
                        </tr>
                    </table>
                </div>

                
                <!-- Technician Details-->
                <div class="row">
                    <div class="col-12" style="border-bottom:1px solid #f5f5f5">
                        <br/><br/>
                        <h3>Technician Information</h3>
                    </div>
                </div>
                <div class="row">
                    <table width="100%" class="my_table">
                        <tr>
                            <td style="width:15%"><b>Technician</b></td>
                            <td style="width:35%"><span t-field="repair.user_id.name"/></td>
                            <td style="width:15%"><b>Team</b></td>
                            <td style="width:35%"><span t-field="repair.team_id"/></td>
                        </tr>
                        <tr>
                            <td style="width:15%"><b>Company</b></td>
                            <td style="width:35%"><span t-field="repair.company_id"/></td>
                            <td style="width:15%"></td>
                            <td style="width:35%"></td>
                        </tr>
                    </table>
                </div>
                <div class="row">
                    <div class="col-12" style="border-bottom:1px solid #f5f5f5">
                        <br/><br/>
                        <h3>Other Information</h3>
                    </div>
                </div>
                
                <div class="row">
                    <table width="100%" class="my_table">
                        <tr>
                            <td style="width:15%"><b>Request Date</b></td>
                            <td style="width:35%"><span t-field="repair.request_date" t-options ='{"format": "dd-MM-yyyy"}'/></td>
                            <td style="width:15%"><b>Close Date</b></td>
                            <td style="width:35%"><span t-field="repair.close_date" t-options ='{"format": "dd-MM-yyyy"}'/></td>
                        </tr>
                        <tr>
                            <td style="width:15%"><b>Is Repaired</b></td>
                            <td style="width:35%">
                                <t t-if="repair.is_repair">
                                    <i style="color:green" class="fa fa-check" />
                                </t>    
                                <t t-if="not repair.is_repair">
                                    <i style="color:red" class="fa fa-times" />
                                </t>
                            </td>
                            <td style="width:15%"> <b>Duration</b></td>
                            <td style="width:35%"><span t-field="repair.duration"/> Hours </td>
                        </tr>
                        <tr>
                            <td style="width:15%"><b>Priority</b></td>
                            <td colspan="3" style="color:gold;font-size:20px;">
                                <t t-foreach="repair.get_priority()" t-as="p">
                                    <i class="fa fa-star"></i>
                                </t>
                            </td>
                        </tr>
                    </table>
                </div>
                
<!--                <t t-if="repair.timesheet_lines">-->
<!--                    <div class="row">-->
<!--                        <div class="col-12">-->
<!--                            <table width="100%" class="my_time_table" style="page-break-inside: avoid">-->
<!--                                <thead>-->
<!--                                    <tr style="border-bottom:1px solid #f5f5f5">-->
<!--                                        <th class="text-left" colspan="4"><br/><br/>-->
<!--                                            <h3>Timesheet Information</h3>-->
<!--                                        </th>-->
<!--                                    </tr>-->
