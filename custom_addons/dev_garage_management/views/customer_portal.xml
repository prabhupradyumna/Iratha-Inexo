<!--                                        <th class="text-left" style="width:20%">Employee</th>-->
<!--                                        <th class="text-left" style="width:40%">Description</th>-->
<!--                                        <th class="text-right" style="width:20%">Hours</th>-->
<!--                                    </tr>-->
<!--                                </thead>-->
<!--                                <tbody>-->
<!--                                    <tr t-foreach="repair.timesheet_lines" t-as="line" style="page-break-inside: avoid">-->
<!--                                        <td class="text-left" style="width:20%">-->
<!--                                            <span t-field="line.date" t-options ='{"format": "dd-MM-yyyy"}'/>-->
<!--                                        </td>-->
<!--                                        <td class="text-left" style="width:20%"><span t-field="line.employee_id"/></td>-->
<!--                                        <td class="text-left" style="width:40%"><span t-field="line.name"/></td>-->
<!--                                        <td class="text-right" style="width:20%"><span t-esc="'%.2f'%(line.unit_amount)"/></td>-->
<!--                                    </tr>-->
<!--                                </tbody>-->
<!--                            </table>-->
<!--                        </div>-->
<!--                    </div>-->
<!--                </t>-->
                
                <t t-if="repair.product_lines">
                    <div class="row">
                        <div class="col-12">
                            <table width="100%" class="my_time_table" style="page-break-inside: avoid">
                                <thead>
                                    <tr style="border-bottom:1px solid #f5f5f5">
                                        <th class="text-left" colspan="5"><br/><br/>
                                            <h3>Consume Product Information</h3>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th class="text-left" style="width:25%">Product</th>
                                        <th class="text-left" style="width:30%">Description</th>
                                        <th class="text-left" style="width:15%">Quantity</th>
                                        <th class="text-center" style="width:15%">UOM</th>
                                        <th class="text-right" style="width:15%">Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="repair.product_lines" t-as="line" style="page-break-inside: avoid">
                                        <td class="text-left">
                                            <span t-field="line.product_id"/>
                                        </td>
                                        <td class="text-left">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td class="text-left">
                                            <span t-esc="'%.2f'%(line.quantity)"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-field="line.uom_id"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="line.price" t-options='{"widget": "monetary", "display_currency": repair.company_id.currency_id}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
                
                <t t-if="repair.instruction_lines">
                    <div class="row">
                        <div class="col-12">
                            <table width="100%" class="my_time_table" style="page-break-inside: avoid">
                                <thead>
                                    <tr style="border-bottom:1px solid #f5f5f5">
                                        <th class="text-left" colspan="5"><br/><br/>
                                            <h3>Service Inspection</h3>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th class="text-left" style="width:75%">Inspection</th>
                                        <th class="text-left" style="width:25%">Checked</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="repair.instruction_lines" t-as="line" style="page-break-inside: avoid">
                                        <td class="text-left">
                                            <span t-field="line.instruction_id"/>
                                        </td>
                                        <td class="text-left">
                                            <t t-if="line.is_check">
                                                <i style="color:green" class="fa fa-check" />
                                            </t>    
                                            <t t-if="not line.is_check">
                                                <i style="color:red" class="fa fa-times" />
                                            </t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
                
                <t t-if="repair.notes">
                    <div class="row">
                        <div class="col-12" style="border-bottom:1px solid #f5f5f5">
                            <br/><br/>
                            <h3>Description</h3>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <br/>
                            <span t-field="repair.notes"/>
                        </div>
                    </div>
                </t>

            </div>
        </div>
    </template>
    
