<odoo>

    <template id="portal_my_home_repair_request" name="Portal My Home: Customer Details" customize_show="True"
              inherit_id="portal.portal_my_home" priority="20">
    	<xpath expr="//div[hasclass('o_portal_docs')]" position="before">
    	<t t-set="portal_client_category_enable" t-value="True"/>
    	<t t-set="portal_alert_category_enable" t-value="True"/>
    	</xpath>
    	<div id="portal_alert_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon"
                    t-value="'/dev_garage_management/static/description/images/job_card.png'"
                    style="height:64px;width:64px;" />
                <t t-set="title">Job Card</t>
                <t t-set="text">Follow, view or print your job cards</t>
                <t t-set="url" t-value="'/my/job_card'" />
                <t t-set="placeholder_count" t-value="'repair_request'" />
            </t>
    	</div>
 	</template>
    
    <template id="portal_my_home_menu_repair" name="Portal layout : Repair menu entries" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'repair' or repair and repair.state not in ('cancel')" t-attf-class="breadcrumb-item #{'active ' if not repair else ''}">
                <a t-if="repair_request" t-attf-href="/my/job_card?{{ keep_query() }}">Job Card</a>
                <t t-else="">Job Card</t>
            </li>
            <li t-if="repair_request" class="breadcrumb-item active">
                <t t-esc="p_name"/>
            </li>
        </xpath>
    </template>
    
    
    
    <template id="portal_my_repair_request" name="My Machine Repair Request">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Job Card</t>
            </t>
            <t t-if="not repair">
                <p>There are currently no Job Card for your account.</p>
            </t>
            <t t-if="repair" t-call="portal.portal_table">

		    <t t-foreach="grouped_repairs" t-as="groupe_repair">
                   <thead>
                       <tr t-attf-class="{{'thead-light' if not groupby == 'none' else ''}}">
                       		<th t-if="groupby == 'none'">Name</th>
                            <th t-else="">
                                <t t-if="groupby == 'product_id'">
                                    <em class="font-weight-normal text-muted">Vehicle:</em>
                               		<span t-esc="groupe_repair[0].sudo().product_id.name"/>
                                </t>
                                <t t-if="groupby == 'state'">
                                    <em class="font-weight-normal text-muted">State:</em>
                                   	<span t-esc="groupe_repair[0].sudo().state"/>
                                </t>
                            </th>
                        <th class="text-center">Request Date</th>
                        <th class="text-left">Customer</th>
                        <th class="text-left">Vehicle Model</th>
                        <th class="text-center">State</th>
                       </tr>
                   </thead>
                   <tbody>
                       <t t-foreach="groupe_repair" t-as="l">
	                    <tr>
	                        <td><a t-att-href="l.get_portal_url()"><t t-esc="l.name"/></a></td>
		                    <td class="text-center"><span t-field="l.request_date" t-options='{"widget": "date"}'/></td>
		                    <td class="text-left"><span t-field="l.customer_id.name"/></td>
		                    <td class="text-left"><span t-field="l.product_id"/></td>
                            <td style="text-align:center;">
                                <t t-if="l.state == 'draft' or l.state == 'assign' " name="status_draft">
                                    <span class="badge rounded-pill text-bg-info" t-field="l.state"/>
                                </t>
                                <t t-elif="l.state=='cancel'" name="status_cancelled">
                                    <span class="badge rounded-pill text-bg-danger" t-field="l.state"/>
                                </t>
                                <t t-elif="l.state=='done' or l.state=='confirm'" name="status_done">
                                    <span class="badge rounded-pill text-bg-success" t-field="l.state"/>
                                </t>
                                <t t-else=" " name="status_confirm">
                                    <span class="badge rounded-pill text-bg-warning" t-field="l.state"/>
                                </t>
                            </td>
		                </tr>
                       </t>
                   </tbody>
               </t>
            </t>
        </t>
    </template>
    
    
    <template id="repair_portal_template" name="Job Card" inherit_id="portal.portal_sidebar" primary="True">
