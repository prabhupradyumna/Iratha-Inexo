<odoo>
    <record id="form_config_dev_garage_management" model="ir.ui.view">
        <field name="name">form_config_dev_garage_management_</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
        	<xpath expr="//form" position="inside">
                <app data-string="Garage" string="Garage" name="dev_garage_management">
                     <block title="Renewable Notification Interval" name="garage_block_1">
                        <setting id="garage_setting_1" >
                             <div class="content-group" name="garage_setting1_div1">
                                 <div class="d-flex">
                                    <label for="month_duration" class="o_light_label"/>
                                    <field name="month_duration" class="ml16"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
	
    <record id="action_config_dev_garage_management" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
<!--        <field name="target">inline</field>-->
        <field name="context">{'module' : 'dev_garage_management'}</field>
    </record>

    <menuitem id="menu_config_dev_garage_management"
              name="Settings"
              parent="menu_dev_repair_configration"
              sequence="0"
              action="action_config_dev_garage_management"/>
</odoo>
