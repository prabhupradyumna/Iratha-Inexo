<odoo>

<record id='inspection_template_form_view' model='ir.ui.view'>
        <field name="name">inspection.template.form.view</field>
        <field name="model">inspection.template</field>
        <field name="arch" type="xml">
            <form string='Inspection Template Form'>
                <sheet>
                     <div class="oe_title">
                         <h1 class="d-flex flex-row">
                            <field name='name' placeholder="Name"/>
                         </h1>
                    </div>
                   
                    <notebook>
                        <page name='inspection' string='Inspection'>
                            <field name='inspection_ids'/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
</record>

    <record id='inspection_template_tree_view' model='ir.ui.view'>
        <field name='name'>inspection.template.tree.view</field>
        <field name='model'>inspection.template</field>
        <field name='arch' type='xml'>
            <list string='Inspection Template Tree'>
                <field name="name"/>
            </list>
        </field>  
    </record>

 <record id='inspection_template_menu_action' model='ir.actions.act_window'>
        <field name='name'>Inspection Template</field>
        <field name='type'>ir.actions.act_window</field>
        <field name='res_model'>inspection.template</field>
        <field name='view_mode'>list,form</field>
 </record>
    <menuitem name='Inspection Template' parent='dev_garage_management.menu_garage_inspection_configure' id='inspection_template_menu_id' action='inspection_template_menu_action' sequence='2'/>
</odoo>
