<odoo>
    <record id="form_lead_garage_manage" model="ir.ui.view">
        <field name="name">form_lead_garage_manage</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
        
             <xpath expr="//button[@name='action_set_won_rainbowman']" position="before" >
                    <button name="action_create_job_card"
                            type="object"  string="Create Job Order" class="oe_highlight"
                            invisible="type == 'lead'"
                            />
             </xpath>

            <xpath expr="//div[@name='button_box']" >
                <button  name="action_job_card" type="object" class="oe_highlight" icon="fa-id-card" invisible="job_card == 0">
                    <field string="Job Card"  name="job_card" widget="statinfo"/>
                </button>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="after">
                    <page string="Vehicle Information ">
                        <group>
                            <group>
                                <field name="product_id" required="1"/>
                                <field name="machine_name" required="1"/>
                                <field name="demage" required="1"/>
                                <field name="repair_issue" required="1"/>
                                <field name="repair_reason" required="1"/>
                            </group>
                            <group>
                                 <field name="service_id" required="1"/>
                                 <field name="service_type_id" required="1"/>
                            </group>
                        </group>
                    </page>
            </xpath>
        </field>
    </record>
    
    <record id="action_crm_lead" model="ir.actions.act_window">
        <field name="name">Lead</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
         <field name="domain">[('service_id', '!=', False),('type','=','lead')]</field>
        
    </record>
        <record id="action_crm_pipeline" model="ir.actions.act_window">
        <field name="name">Pipeline</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
         <field name="domain">[('service_id', '!=', False),('type','=','opportunity')]</field>
        
    </record>

    <menuitem name="Lead"
              id="menu_lead_garage_management"
              parent="menu_dev_repair_menu"
              sequence="1"/>
    <menuitem name="Lead"
              id="sub_menu_lead_garage"
              parent="menu_lead_garage_management"
              action="action_crm_lead"
              sequence="1"/>
    <menuitem name="Pipeline"
              id="sub_menu_pipeline_garage"
              parent="menu_lead_garage_management"
              action="action_crm_pipeline"
              sequence="2"/>
</odoo>
