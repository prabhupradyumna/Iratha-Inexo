#. module: dev_garage_management
#: model:mail.template,body_html:dev_garage_management.customer_email_template_garage_job_closed
msgid ""
"<p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                     Dear <b><span t-esc=\"object.customer_id.name or ''\"/></b>,\n"
"                    <br/><br/>\n"
"                   </p><p> Your repair request of job card number<b> <span t-esc=\"object.name or ''\"/> </b> is done, </p>\n"
"                   <p>  so we have closed your request now. </p>\n"
"                   <p> We also attached the report of your job card.</p>\n"
"                   <br/>\n"
"                   <p>  Thanks For Your Participation...! </p>\n"
"                    <br/>\n"
"                   <p> You can reply to this email if you have any questions.</p>\n"
"                   <p>  Thank you... </p>\n"
"                    <br/>\n"
"                \n"
"\n"
"\n"
"                "
msgstr ""
"<p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                     Caro <b><span t-esc=\"object.customer_id.name or ''\"/></b>,\n"
"                    <br/><br/>\n"
"                   </p><p> La tua richiesta di riparazione del numero della scheda di lavoro<b> <span t-esc=\"object.name or ''\"/> </b> è fatto, </p>\n"
"                   <p>  pertanto abbiamo chiuso la tua richiesta. </p>\n"
"                   <p>Alleghiamo anche il rapporto sulla tua scheda di lavoro.</p>\n"
"                   <br/>\n"
"                   <p>  Grazie per la partecipazione...! </p>\n"
"                    <br/>\n"
"                   <p>Se hai domande puoi rispondere a questa email.</p>\n"
"                   <p>  Grazie... </p>\n"
"                    <br/>\n"
"                \n"
"\n"
"\n"
"                "


#. module: dev_garage_management
#: model:mail.template,body_html:dev_garage_management.customer_service_renew_garage_template
msgid ""
"<p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                     Dear <span t-esc=\"object.customer_id.name or ''\"/>,\n"
"                    <br/><br/>\n"
"                   </p><p> Your repair request of job card number<b> <span t-esc=\"object.name or ''\"/> </b> is done on <span t-esc=\"object.request_date or ''\"/> </p>\n"
"                   <p>  now it's been <span t-esc=\"object.company_id.month_duration or ''\"/> months from your last service date</p>\n"
"                   <br/>\n"
"                   <p>  So, We request you to service your vehicle </p>\n"
"                    <br/>\n"
"                   <p> If you have any questions regarding the renewal process or need help, please don't hesitate to contact us.</p>\n"
"                   <p> Thank you... </p>\n"
"                    <br/>\n"
"                \n"
"\n"
"\n"
"                "
msgstr ""
"<p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                     Caro <span t-esc=\"object.customer_id.name or ''\"/>,\n"
"                    <br/><br/>\n"
"                   </p><p>La tua richiesta di riparazione del numero della scheda di lavoro<b> <span t-esc=\"object.name or ''\"/> </b> è fatto su <span t-esc=\"object.request_date or ''\"/> </p>\n"
"                   <p> ora è stato <span t-esc=\"object.company_id.month_duration or ''\"/> mesi dalla data dell'ultimo servizio</p>\n"
"                   <br/>\n"
"                   <p> Pertanto, ti chiediamo di effettuare la manutenzione del tuo veicolo </p>\n"
"                    <br/>\n"
"                   <p>Se hai domande in merito al processo di rinnovo o hai bisogno di aiuto, non esitare a contattarci.</p>\n"
"                   <p> Grazie... </p>\n"
"                    <br/>\n"
"                \n"
"\n"
"\n"
"                "

