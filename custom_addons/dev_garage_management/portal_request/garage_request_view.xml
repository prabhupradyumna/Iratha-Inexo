                                <div class="col-md-3">
                                    <form id="appointmentForm" action="/general_appointment" method="POST">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="appointment_id" t-att-value="services.id"/>
                                        <div class="service-card">
                                            <t t-if="services.icon_image">
                                                <div class="service-icon">
