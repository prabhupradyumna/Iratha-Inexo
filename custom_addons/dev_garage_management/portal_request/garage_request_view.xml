<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="garage_request_template" name="Garage Appointment">
        <t t-call="website.layout">
            <style>
        
        
        body {
            font-family: 'Poppins', sans-serif;
            color: #212529;
            overflow-x: hidden;
        }
        
        h1, h2, h3, h4, h5, .display-1, .display-2, .display-3, .display-4, .display-5, .display-6 {
            font-family: 'Playfair Display', serif;
            font-weight: 600;
        }
        
        
        
        .btn-primarys {
            background-color: #2a7fba;
            border-color: #2a7fba;
            transition: all 0.3s;
        }
        
        .btn-primarys:hover {
            background-color: #1d5f8a;
            border-color: #1d5f8a;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(42, 127, 186, 0.3);
        }
        
        .btn-outline-primary {
            color: #2a7fba;
            border-color: #2a7fba;
        }
        
        .btn-outline-primary:hover {
            background-color: #2a7fba;
            border-color: #2a7fba;
        }
        
        /* Hero Section */
        .hero {
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('dev_garage_management/static/src/img/worker-follows-car-checklist-fixing-tires.jpg') center/cover no-repeat;
            color: white;
            padding: 180px 0 120px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
                        
        
        .hero-content {
            position: relative;
            z-index: 2;
        }
        
        .hero h1 {
            font-size: 3.5rem;
            font-weight: 700;
            margin-bottom: 25px;
            line-height: 1.2;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }
        
        .hero p {
            font-size: 1.35rem;
            max-width: 700px;
            margin: 0 auto 40px;
            opacity: 0.9;
        }
        
        .hero-btns .btn {
            margin: 0 10px;
            padding: 12px 30px;
            font-weight: 500;
            border-radius: 50px;
        }
        
        .hero-btns .btn-light {
            background-color: white;
            color: #2a7fba;
        }
        
        .hero-btns .btn-light:hover {
            transform: translateY(-2px);
            box-shadow: 0 0px 10px rgba(255, 255, 255, 1);
            background-color:white;
            color: #2a7fba;
        }
        
        .hero-btns .btn-outline-light {
            border-width: 2px;
        }
        
        /* Floating Animation */
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
            100% { transform: translateY(0px); }
        }
        
        .floating {
            animation: float 6s ease-in-out infinite;
        }
        
        /* Services Section */
        .services {
            position: relative;
            padding: 100px 0;
            overflow: hidden;
        }
        
        .services::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0.03;
            z-index: -1;
        }
        
        .section-title {
            position: relative;
            display: inline-block;
            margin-bottom: 50px;
        }
        
        .section-title::after {
            content: '';
            position: absolute;
            width: 50px;
            height: 3px;
            background-color: #2a7fba;
            bottom: -15px;
            left: 50%;
            transform: translateX(-50%);
        }
        

        <!-- card -->
        .service-card {
            background: #fff;
            border-radius: 10px;
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.26);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
        }

        .service-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
        }

        .service-icon {
            font-size: 2.5rem;
            color: #0d6efd; /* Bootstrap primary color */
            margin-bottom: 20px;
            
        }

        .service-card h3 {
            font-size: 1.5rem;
            margin-bottom: 15px;
            color: #333;
        }

        .service-card p {
            color: #666;
            margin-bottom: 20px;
        }

        .btn-primary {
            <!-- background-color: #3D85BA; -->
            border: none;
            padding: 8px 20px;
            border-radius: 5px;
            font-weight: 500;
        }

        .btn-primary:hover {
            background-color: #0b5ed7;
        }
        
        /* About Section */
        .about {
            padding: 100px 0;
            background-color: #f8f9fa;
            position: relative;
        }
        
        .about-img {
            border-radius: 15px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            transition: all 0.4s;
        }
        
        .about-img:hover {
            transform: scale(1.02);
        }
        
        .feature-icon {
            width: 50px;
            height: 50px;
            background-color: rgba(42, 127, 186, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            color: #2a7fba;
            font-size: 1.25rem;
        }
        
        .feature-item {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }
        
        /* Stats Section */
        .stats {
            padding: 80px 0;
            background: linear-gradient(rgba(42, 127, 186, 0.9), rgba(42, 127, 186, 0.9)), url('https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?ixlib=rb-4.0.3&amp;auto=format&amp;fit=crop&amp;w=1950&amp;q=80') center/cover;
            color: white;
            text-align: center;
        }
        
        .stat-item {
            padding: 20px;
        }
        
        .stat-number {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 10px;
            font-family: 'Playfair Display', serif;
        }
        
        .stat-text {
            font-size: 1.1rem;
            opacity: 0.9;
        }
        
        /* Team Section */
        .team {
            padding: 50px 0;
        }
        
        .team-member {
            text-align: center;
            margin-bottom: 30px;
            transition: all 0.3s;
        }
        
        .team-member:hover {
            transform: translateY(-10px);
        }
        
        .team-member-img {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 20px;
            border: 8px solid white;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: all 0.3s;
        }
        
        .team-member:hover .team-member-img {
            border-color: #2a7fba;
        }
        
        .team-social {
            margin-top: 15px;
        }
        
        .team-social a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 35px;
            height: 35px;
            background-color: rgba(42, 127, 186, 0.1);
            color: #2a7fba;
            border-radius: 50%;
            margin: 0 5px;
            transition: all 0.3s;
        }
        
        .team-social a:hover {
            background-color: #2a7fba;
            color: white;
            transform: translateY(-3px);
        }
        
        
        
        /* Appointment Section */
        .appointment {
            padding: 100px 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e8eb 100%);
        }
        
        .appointment-form {
            background-color: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }
        
        .form-control, .form-select {
            padding: 12px 15px;
            border-radius: 8px;
            border: 1px solid #e1e5ee;
            transition: all 0.3s;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #2a7fba;
            box-shadow: 0 0 0 0.25rem rgba(42, 127, 186, 0.25);
        }
        
        /* Contact Section */
        .contact {
            padding: 50px 0;
        }
        
        .contact-info-card {
            background-color: white;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            transition: all 0.3s;
            height: 100%;
            text-align: center;
        }
        
        .contact-info-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.1);
        }
        
        .contact-icon {
            width: 70px;
            height: 70px;
            background-color: rgba(42, 127, 186, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            color: #2a7fba;
            font-size: 1.75rem;
            transition: all 0.3s;
        }
        
        .contact-info-card:hover .contact-icon {
            background-color: #2a7fba;
            color: white;
        }
        
        
        
        /* Back to Top Button */
        .back-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 50px;
            height: 50px;
            background-color: #2a7fba;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            z-index: 999;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .back-to-top.active {
            opacity: 1;
            visibility: visible;
        }
        
        .back-to-top:hover {
            background-color: #1d5f8a;
            transform: translateY(-3px);
        }
        
        /* Responsive */
        @media (max-width: 992px) {
            .hero h1 {
                font-size: 2.8rem;
            }
            
            .hero p {
                font-size: 1.2rem;
            }
        }
        
        @media (max-width: 768px) {
            .hero {
                padding: 150px 0 100px;
            }
            
            .hero h1 {
                font-size: 2.2rem;
            }
            
            .hero p {
                font-size: 1rem;
            }
            
            .hero-btns .btn {
                padding: 10px 20px;
                margin-bottom: 10px;
            }
            
            .section-title {
                margin-bottom: 30px;
            }
        }
        
        @media (max-width: 576px) {
            .hero h1 {
                font-size: 1.8rem;
            }
            
            .navbar-brand {
                font-size: 1.5rem;
            }
        }

        .btn-reset {
                all: unset;
                cursor: pointer;
                display: inline-block;
        }

        .marcellus-regular {
                font-family: "Marcellus", serif;
                font-weight: 400;
                font-style: normal;
                }


