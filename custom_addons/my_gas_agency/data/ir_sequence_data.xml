<odoo>
    <data noupdate="1">
        <record id="seq_gas_agency_sale" model="ir.sequence">
            <field name="name">Gas Agency Sale Sequence</field>
            <field name="code">gas.agency.sale</field>
            <field name="prefix">B No </field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_gas_agency_payment" model="ir.sequence">
            <field name="name">Gas Agency Payment Sequence</field>
            <field name="code">gas.agency.payment</field>
            <field name="prefix">PAY/A/ </field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>