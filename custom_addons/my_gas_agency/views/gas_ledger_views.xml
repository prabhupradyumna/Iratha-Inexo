<odoo>
    <data>
        <record id="my_gas_agency.gas_agency_ledger_action" model="ir.actions.act_window">
            <field name="name">Partner Ledger</field>
            <field name="res_model">gas.agency.ledger</field>
            <field name="view_mode">list</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No ledger entries found.
                </p>
                <p>
                    Create a new Invoice for a commercial customer or
                    Register a new Payment to see entries here.
                </p>
            </field>
        </record>

        <record id="gas_agency_ledger_list_view" model="ir.ui.view">
            <field name="name">gas.agency.ledger.list</field>
            <field name="model">gas.agency.ledger</field>
            <field name="arch" type="xml">
                <list string="Partner Ledger" create="0" edit="0" delete="0">
                    <field name="date"/>
                    <field name="particulars"/>
                    <field name="partner_id"/>
                    <field name="filled_qty"/>
                    <field name="empty_qty"/>
                    <field name="debit" sum="Total Debit"/>
                    <field name="credit" sum="Total Credit"/>
                </list>
            </field>
        </record>
    </data>
</odoo>