<odoo>
    <record id="my_gas_agency.gas_agency_payment_action" model="ir.actions.act_window">
        <field name="name">Customer Payments</field>
        <field name="res_model">gas.agency.payment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No customer payments found. Let's create one!
            </p>
        </field>
    </record>

    <record id="gas_agency_payment_list_view" model="ir.ui.view">
        <field name="name">gas.agency.payment.list</field>
        <field name="model">gas.agency.payment</field>
        <field name="arch" type="xml">
            <list string="Customer Payments">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="journal"/>
                <field name="amount" sum="Total Amount"/>
            </list>
        </field>
    </record>

    <record id="gas_agency_payment_form_view" model="ir.ui.view">
        <field name="name">gas.agency.payment.form</field>
        <field name="model">gas.agency.payment</field>
        <field name="arch" type="xml">
            <form string="Customer Payment">
                <sheet>
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="journal"/>
                            <field name="amount"/>
                        </group>
                    </group>
                </sheet>
                </form>
        </field>
    </record>
</odoo>