<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_form_inherit_gas_agency" model="ir.ui.view">
            <field name="name">res.partner.form.gas.agency.ledger.button</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <!-- Add button in the button box -->
                <div name="button_box" position="inside">
                    <button
                            name="action_view_gas_agency_ledger"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-book">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Ledger</span>
                        </div>
                    </button>
                </div>

                <!-- Add the is_commercial_customer field -->
                <notebook position="inside">
                    <page string="Gas Agency" name="gas_agency">
                        <group>
                            <field name="is_commercial_customer"/>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>

    </data>
</odoo>
